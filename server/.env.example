# Copy this file to .env (same folder) and paste your key after the = sign.
# .env is gitignored, so your key never gets committed.
ANTHROPIC_API_KEY=
PORT=8787

# Voice (speech-to-text + Mika's voice) via Boson AI: get a key at https://boson.ai/workspace
BOSON_API_KEY=
# Preset voice: chloe (friendly), nora (calm), eleanor (professional)
BOSON_VOICE=chloe

# Which voice to use: "boson" (hosted, needs BOSON_API_KEY) or "local" (free, open-source,
# runs on this Mac: start voice-server/start.sh first; see voice-server/README.md).
VOICE_PROVIDER=boson
# Local voice settings (all optional; these are the defaults).
# LOCAL_VOICE_URL=http://127.0.0.1:8000/v1
# LOCAL_VOICE=af_heart
