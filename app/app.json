{
  "expo": {
    "name": "Mika Planner",
    "slug": "mika-planner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.mikaplanner.companion",
      "infoPlist": {
        "NSAlarmKitUsageDescription": "Mika sets real alarms for you, so they ring even when the app is closed or your phone is on silent."
      },
      "appleTeamId": "TH83HV8VFA"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.mikaplanner.companion"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withoutPushEntitlement",
      "expo-router",
      "expo-sqlite",
      [
        "expo-calendar",
        {
          "calendarPermission": "Mika reads and adds events to your calendar when you ask her to plan your day."
        }
      ],
      [
        "expo-notifications",
        {}
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Mika listens when you talk to her, so she can help plan your day."
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "18.0"
          }
        }
      ]
    ],
    "scheme": "mikaplanner"
  }
}
